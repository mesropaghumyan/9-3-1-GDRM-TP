# Environnement d'exécution : development | test | production
NODE_ENV=development

# Port d'écoute du serveur HTTP
PORT=3000

# Niveau de log Pino : fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Fournisseurs actifs, changeables sans recompilation (cf. docs/TP_2.md, docs/STD.md §3.6)
GEOCODING_PROVIDER=ban
WEATHER_PROVIDER=open-meteo

# Services externes (cf. docs/TP_1.md, docs/TP_2.md, docs/STD.md)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
BAN_BASE_URL=https://api-adresse.data.gouv.fr
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
MET_NORWAY_BASE_URL=https://api.met.no/weatherapi/locationforecast/2.0

# Résilience des appels sortants (cf. docs/STD.md §3.7)
HTTP_TIMEOUT_MS=5000
GEOCODING_CACHE_TTL_MS=3600000

# Rate limiting entrant (cf. docs/STD.md §10)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
