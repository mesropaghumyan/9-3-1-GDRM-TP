{
  "name": "tp-meteo-api",
  "version": "0.1.0",
  "private": true,
  "description": "API météo par adresse — TP1 Gestion des dépendances, risques et maintenabilité",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/server.js",
  "config": {
    "licenseChecker": "license-checker@25.0.1"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.jest.json --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "licenses:scan": "npx --yes $npm_package_config_licenseChecker --excludePrivatePackages --json --out reports/licenses.json",
    "licenses:check": "npm run licenses:scan && tsx scripts/licenses/checkLicenses.ts reports/licenses.json license-policy.json",
    "licenses:report": "npx --yes $npm_package_config_licenseChecker --excludePrivatePackages --markdown --out docs/tp4/licenses.md && npx --yes $npm_package_config_licenseChecker --excludePrivatePackages --production --markdown --out docs/tp4/licenses-production.md && npx --yes $npm_package_config_licenseChecker --excludePrivatePackages --summary > docs/tp4/licenses-summary.txt",
    "sbom": "mkdir -p reports && npm sbom --sbom-format=cyclonedx --omit=dev > reports/sbom.cdx.json"
  },
  "dependencies": {
    "dotenv": "^18.0.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "pino": "^10.3.1",
    "reflect-metadata": "^0.2.2",
    "swagger-ui-express": "^5.0.1",
    "tsyringe": "^4.10.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^9.9.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.3",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.1",
    "msw": "^2.11.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.8",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.0"
  }
}
